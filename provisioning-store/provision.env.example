# ── Store provisioner — provision.env (written by setup.sh, edited by hand after) ──
# Everything the service and its scripts need lives here. setup.sh preserves
# values you set on re-run. Keep this file 0600 root.

# nit2 → provisioner auth (X-Provision-Secret). Generated by setup.sh when empty.
PROVISION_SECRET=
PROVISION_PORT=9098
# Where stores live: clients/<slug>/{store.env,compose.yml,bootstrap.json}, logs/, staging/, jobs.sqlite
STORE_ROOT=/var/www/html/saas-stores
# Base domain: a store is https://<slug>.<STORE_DOMAIN>  (wildcard A record → this host)
STORE_DOMAIN=commerce.nitg-eg.com

# Images (three, same tag): $REGISTRY/saas-store-{api,site,dash}:$IMAGE_TAG
REGISTRY=ghcr.io/nitgg
IMAGE_TAG=latest
# GHCR pull credentials (a PAT with read:packages). setup.sh runs `docker login` with them.
GHCR_USER=
GHCR_TOKEN=

# Host web server that fronts the stores: nginx | apache (setup.sh detects when empty)
PROXY=
# TLS per store: per-host (certbot HTTP-01 at creation, like the academies) | none (behind another TLS terminator)
TLS_MODE=per-host
LE_EMAIL=admin@nitg-eg.com

# Progress callbacks to nit2: POST $CALLBACK_URL/api/tenants/<slug>/progress with x-worker-secret
CALLBACK_URL=
WORKER_SECRET=

# Host ports handed to store containers (3 per store: site, dash, api), starting here
PORT_BASE=9100
# Per-container caps (compose reads them from each store.env; written at creation)
API_MEM=384m
SITE_MEM=256m
DASH_MEM=192m
# Parallel creations
MAX_CONCURRENT=2

# Shared MariaDB container on the saas_net network (created by setup.sh if absent;
# on the academy box the existing saas_mariadb is reused and DB_ROOT_PW comes from
# /var/www/html/saas/saas.env)
SAAS_DB_CONTAINER=saas_mariadb
DB_ROOT_PW=

# Platform-wide values copied into every store.env
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# nit2 base URL → dashboard "Upgrade / Renew" link
ACCOUNT_URL=
# Logo upload cap (MB) — keep >= nit2's max_image_mb
MAX_IMAGE_MB=5
# Rollout summary ping (bump-image.sh --all). Blank = disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
