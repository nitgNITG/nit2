{
  "name": "nit-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate && prisma generate --schema prisma/mysql/schema.prisma",
    "build": "npx prisma generate && npx prisma generate --schema prisma/mysql/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate && prisma generate --schema prisma/mysql/schema.prisma",
    "mongo:generate": "prisma generate",
    "mongo:push": "prisma db push",
    "mongo:pull": "prisma db pull",
    "mongo:studio": "prisma studio",
    "mysql:generate": "prisma generate --schema prisma/mysql/schema.prisma",
    "mysql:migrate": "prisma migrate dev --schema prisma/mysql/schema.prisma",
    "mysql:deploy": "prisma migrate deploy --schema prisma/mysql/schema.prisma",
    "mysql:push": "prisma db push --schema prisma/mysql/schema.prisma",
    "mysql:pull": "prisma db pull --schema prisma/mysql/schema.prisma",
    "mysql:status": "prisma migrate status --schema prisma/mysql/schema.prisma",
    "mysql:studio": "prisma studio --schema prisma/mysql/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "animate.css": "^4.1.1",
    "axios": "^1.7.3",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "firebase-admin": "^12.3.1",
    "jsonwebtoken": "^9.0.2",
    "next": "14.2.5",
    "next-intl": "^3.17.4",
    "prisma": "^5.18.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "react-fast-marquee": "^1.6.5",
    "react-hook-form": "^7.52.2",
    "react-hot-toast": "^2.4.1",
    "sharp": "^0.34.5",
    "zustand": "^4.5.4"
  },
  "browserslist": [
    "chrome >= 90",
    "firefox >= 90",
    "safari >= 14",
    "edge >= 90",
    "ios_saf >= 14",
    "samsung >= 14",
    "not dead"
  ],
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.19.41",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
