# ============================================================
# N.I.T Website — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# MongoDB connection string (MongoDB Atlas recommended)
# Format: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/nit_db?retryWrites=true&w=majority"

# JWT secret — use any long random string (min 32 chars)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_JWT="your_super_secret_jwt_key_minimum_32_characters_long"

# Upload directory (production only — omit on localhost)
# Folder on the server where uploaded images are saved (outside the project)
# Nginx must serve this folder at /uploads/
# UPLOAD_DIR=/var/www/nit-uploads
# UPLOAD_URL_PREFIX=/uploads

# Cloudinary — for image uploads (dashboard)
# Find these at: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME="dlrkykxr9"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ============================================================
# SETUP STEPS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in DATABASE_URL with your MongoDB Atlas URI
# 3. Fill in SECRET_JWT with a random secret
# 4. Run: npx prisma generate
# 5. Run: npm run dev
# 6. To create your first admin user, temporarily uncomment
#    the second POST handler in app/api/sign-in/route.ts,
#    call it once with your email/password, then re-comment it.
# ============================================================
