# ============================================================
# N.I.T Website — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# MongoDB connection string (MongoDB Atlas recommended)
# Format: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/nit_db?retryWrites=true&w=majority"

# JWT secret — use any long random string (min 32 chars)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_JWT="your_super_secret_jwt_key_minimum_32_characters_long"

# Upload directory (production only — omit on localhost)
# Folder on the server where uploaded images are saved (outside the project)
# Nginx must serve this folder at /uploads/
# UPLOAD_DIR=/var/www/nit-uploads
# UPLOAD_URL_PREFIX=/uploads

# Cloudinary — for image uploads (dashboard)
# Find these at: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME="dlrkykxr9"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── Academy-as-a-Service ("Build your product" button) ──────────────────────
# Fine-grained GitHub PAT with Contents: Read and write on the SaaS repo.
# The /api/academies endpoint uses it to create a client/<slug> branch off the
# base branch. Keep it server-side only — never expose it to the browser.
GITHUB_TOKEN="github_pat_xxxxxxxxxxxxxxxxxxxx"
# Optional overrides (defaults shown):
# SAAS_REPO_OWNER="NITGg"
# SAAS_REPO_NAME="saas-demo"
# SAAS_BASE_BRANCH="main"
# Max "create academy" requests per IP per hour. 0 = disabled (no limit).
# Default is 5. Set to 0 while testing; put a sane number back for production.
# ACADEMIES_RATE_LIMIT=0

# After creating the branch, the button asks server B to build the live site.
# PROVISION_URL   = the provisioning endpoint on server B (behind Apache + HTTPS).
# PROVISION_SECRET= must match /opt/saas/provision.env on server B (openssl rand -hex 32).
# Leave both empty to skip provisioning (branch-only, provision manually).
PROVISION_URL="https://saas-provision.academy2026.nitg-eg.com/provision"
PROVISION_SECRET="change_me_to_match_server_b"

# Used ONLY by provisioning/deploy-provisioning.sh (push scripts A -> B).
# The secrets (PROVISION_SECRET/GITHUB_TOKEN) are NOT sent — server B reuses its own.
SERVER_B_HOST=""                              # server B ip/hostname (required to deploy)
SERVER_B_USER="deploy"                         # ssh user on server B
SERVER_B_SSH_KEY=""                            # path to ssh private key (optional)
SERVER_B_DEST="/tmp/nit-provisioning"          # staging dir on server B (optional)

# ── Kashier payments (paid academy licences) ────────────────
# From your Kashier merchant dashboard. The API key is ALSO the HMAC key used to
# verify webhooks, so it must be exact. BASE_URL defaults to https://api.kashier.io.
KASHIER_MERCHANT_ID=""      # MID-xxxx
KASHIER_API_KEY=""          # iframe/api key (also the webhook signature key)
KASHIER_SECRET_KEY=""       # secret (sent in the Authorization header)
# KASHIER_BASE_URL="https://api.kashier.io"
# KASHIER_MODE="test"        # test | live (informational)

# Public base URL of THIS app — used to build the Kashier webhook + success URLs.
# Must be reachable by Kashier's servers (no localhost).
APP_BASE_URL="https://dev.nitg-eg.com"

# Shared secret for the expiry cron (POST /api/cron/expiry, header x-cron-secret).
CRON_SECRET=""
# Days past an academy's validUntil before the expiry cron suspends it. Default 3.
# LICENSE_GRACE_DAYS=3

# ============================================================
# SETUP STEPS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in DATABASE_URL with your MongoDB Atlas URI
# 3. Fill in SECRET_JWT with a random secret
# 4. Run: npx prisma generate
# 5. Run: npm run dev
# 6. To create your first admin user, temporarily uncomment
#    the second POST handler in app/api/sign-in/route.ts,
#    call it once with your email/password, then re-comment it.
# ============================================================
