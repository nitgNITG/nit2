[Unit]
Description=SaaS provisioning endpoint (runs create.sh on request)
After=network.target docker.service

[Service]
Type=simple
EnvironmentFile=/var/www/html/saas/provision.env
ExecStart=/usr/bin/python3 /var/www/html/saas/provision-server.py
Restart=on-failure
RestartSec=3
# create.sh needs docker + apache + certbot, so it runs as root.
User=root

[Install]
WantedBy=multi-user.target
