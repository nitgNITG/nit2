# Copy to /var/www/html/saas/provision.env on server B (chmod 600). Never commit the real one.

# Shared secret the button must send in the X-Provision-Secret header.
# Generate one:  openssl rand -hex 32
PROVISION_SECRET=change_me_to_a_long_random_string

# Token used by create.sh to clone the client branch (same one the button uses).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# Optional (defaults shown)
CREATE_SH=/root/create.sh
PROVISION_LOG_DIR=/var/www/html/saas/logs
PROVISION_PORT=9099
