// ─────────────────────────────────────────────────────────────────────────────
// SECONDARY Prisma schema — MySQL, ONLY the Academy control plane.
//
// The primary app DB is MongoDB (prisma/schema.prisma, the default `@prisma/client`).
// This is a SEPARATE Prisma client generated to `../generated/mysql`; import it via
// `@/lib/prismaMysql`. Keep the two apart — no cross-DB relations.
//
// Commands (note the --schema flag):
//   npx prisma generate      --schema prisma/mysql/schema.prisma
//   npx prisma migrate deploy --schema prisma/mysql/schema.prisma   (server / apply)
//   npx prisma migrate dev    --schema prisma/mysql/schema.prisma --name <x>  (needs shadow-DB privilege)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  // Generated into node_modules as a bare package so Next.js can treat it as an
  // external server package (experimental.serverComponentsExternalPackages in
  // next.config) — the native query engine must NOT be webpack-bundled/traced.
  output   = "../../node_modules/prismamysql"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_DATABASE_URL")
}

// Platform-wide settings that MUST be identical for every academy — the values
// bound to the app binary, not to any one tenant: OAuth client ids and the app
// store URLs/versions. This table is the single source of truth; the provisioner
// writes these into each academy's Moodle (local_multitopics config) at create
// time, so the mobile app keeps reading them from each academy's getsettings.php.
//
// NOT here: per-academy secrets (user_token, admin_token, Paymob credentials,
// VdoCipher keys) — those live in each academy's own Moodle, never centralised.
model PlatformSetting {
  key       String   @id // e.g. google_client_id, ios_url, android_version
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Platform users (admins + clients) — auth lives here in MySQL alongside the
// academy control plane. `role`: "admin" | "client" (a null role on legacy rows
// is treated as admin by lib/auth). Passwords are bcrypt hashes.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String?  @default("client")
  createdAt DateTime @default(now())
}

// One record per academy created from the "Build your product" button.
// `slug` is the English identifier the client typed; the SaaS branch is
// `client/<slug>` off `main` in the NITGg/saas-demo repo. `tier` maps to the
// Moodle-side local_license package (demo|basic|standard|professional).
// `ownerId` (optional) is the id of the client User — same MySQL DB, kept as a
// plain string (not a Prisma relation); the account page joins by ownerId.
model Academy {
  id        String   @id @default(uuid())
  name      String // Arabic display name typed by the client
  slug      String   @unique // English identifier — branch suffix + future subdomain
  branch    String // full branch name, e.g. "client/ahmed-academy"
  status    String   @default("branch_created") // branch_created | provisioning | live | failed | suspended
  tier      String   @default("demo") // the License.key this academy runs on
  ownerId   String? // client User id (same MySQL DB; joined by string, not a relation)
  // Subscription term: when the current licence started and when it lapses.
  // `validUntil` null = never expires (License.durationDays = 0). Set on create
  // (and on plan change / renewal) from the License's durationDays.
  subscribedAt DateTime? // start of the current subscription term
  validUntil   DateTime? // end of the term; null = never expires
  // Encrypted (AES-256-GCM) generated admin password, so a lost welcome email can
  // be recovered from the dashboard. NOT a login hash and NOT the owner's chosen
  // password — only the value WE generate at provision / on reset. See lib/secretBox.
  adminPasswordEnc String? @db.Text
  createdAt DateTime @default(now())
}

// A licence "product": the limits + features an academy runs on (pushed to
// local_license) plus the academy quota it grants a client. Fully editable from
// the dashboard — `key` is what Academy.tier references. Seeded to match the
// original demo/basic/standard/professional tiers.
model License {
  id           String   @id @default(uuid())
  key          String   @unique // demo|basic|standard|professional or a custom slug
  name         String
  active       Boolean  @default(true)
  price        Int      @default(0) // USD (display only)
  priceEgp     Int      @default(0) // actual charge in EGP via Kashier; 0 = free (no payment)
  durationDays Int      @default(365) // 0 = never expires
  maxCourses   Int      @default(-1) // -1 = unlimited
  maxTeachers  Int      @default(-1)
  storageGb    Int      @default(1) // moodledata quota (GB) for academies on this licence
  supportedApp Boolean  @default(true) // may academies on this licence open in the mobile app (design_system site.supportedapp); Demo = false
  videoSource  String   @default("all") // all|limited|youtube|vimeo|vdocipher — selects which video integration is pushed
  kashierEnabled Boolean @default(false) // push the shared Kashier gateway config to academies on this licence
  limits       Json // per-activity caps e.g. {"quiz":-1,"video":-1,"pdf":-1,"default":-1}
  features     Json // toggles e.g. {"drm":false,"coupons":true,"subscriptions":false,"packages":false,"jitsi":false,"offers":false}
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

// A Kashier payment for a paid academy licence. Created `pending` when the client
// starts checkout; flipped to `paid` by the verified Kashier webhook, which then
// runs the deferred action (provision a new academy / change tier / renew).
// For a `new_academy` payment the pending create payload lives in `payloadJson`
// so the webhook can provision exactly what the client configured — nothing is
// created until money is confirmed.
model Payment {
  id             String    @id @default(uuid())
  orderId        String    @unique // our merchant order id — Kashier's merchantOrderId
  userId         String // client User id (Mongo app user; joined by string)
  licenseKey     String // License.key being purchased
  purpose        String    @default("new_academy") // new_academy | upgrade | renew
  amount         Int // charged amount, minor unit-free (whole currency units)
  currency       String    @default("EGP")
  status         String    @default("pending") // pending | paid | failed | expired
  academySlug    String? // set for upgrade/renew, and for new_academy once provisioned
  payloadJson    Json? // the pending academy-create payload (name, slug, brand, …)
  sessionId      String? // Kashier session _id
  providerRef    String? // Kashier transactionId / kashierOrderId once paid
  failureReason  String?   @db.Text
  createdAt      DateTime  @default(now())
  paidAt         DateTime?

  @@index([userId])
  @@index([status])
}
