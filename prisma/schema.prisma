// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  email    String  @unique
  password String
  name     String?
}

type ProjectLink {
  headerEn String
  headerAr String
  link     String
}

model Project {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  img           String
  title         String
  titleEn       String?
  descriptionEn String?
  description   String
  important     Boolean?
  types         String[]
  links         ProjectLink[]
  order         Int           @default(0)
}

model ProjectType {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  value   String @unique  // slug used in Project.types[] e.g. "lms", "ecommerce"
  labelEn String
  labelAr String
}

model Sponser {
  id  String @id @default(auto()) @map("_id") @db.ObjectId
  img String
}

// NOTE: the Academy control plane now lives in MySQL, not here — see
// prisma/mysql/schema.prisma (client `@/lib/prismaMysql`). No Academy model in Mongo.

model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // Core fields
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  // Qualifying fields
  country   String?   // "sa" | "ae" | "qa" | "kw" | "bh" | "om" | "jo" | "eg" | "other"
  service   String?   // "moodle" | "ecommerce" | "custom" | "other"
  budget    String?   // "under5k" | "5to20k" | "20to50k" | "above50k" | "unknown"
  timeline  String?   // "immediate" | "1to3months" | "3to6months" | "exploring"
  role      String?   // "owner" | "manager" | "employee" | "other"
  pain      String?
  // Traffic tracking
  sourcePage    String?   // page where form was submitted (/contact | /moodle-lms | /)
  sourceRef     String?   // document.referrer (e.g. google.com)
  utmSource     String?   // ?utm_source=
  utmMedium     String?   // ?utm_medium=
  utmCampaign   String?   // ?utm_campaign=
  // Auto-scored
  score     Int      @default(0)
  stage     String   @default("lead")   // "lead" | "mql" | "sql" | "opportunity"
  // Admin
  status    String   @default("new")    // "new" | "contacted" | "won" | "lost"
  notes     String?
  isReaded  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ServicePlan {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  service   String   // "moodle" | "ecommerce" | "mobile"
  nameAr    String
  nameEn    String
  price     Int      // starting price in USD
  currency  String   @default("USD")
  featuresAr String[] // Arabic feature list
  featuresEn String[] // English feature list
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Article {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  // SEO-friendly URL slug (auto-generated from Arabic title)
  slug              String?   @unique
  // Arabic (primary)
  title             String
  content           String           // intro paragraph AR
  metaDesc          String?          // ≤160 chars for <meta description> AR
  // English
  titleEn           String?
  contentEn         String?          // intro paragraph EN
  metaDescEn        String?          // ≤160 chars for <meta description> EN
  // Media & meta
  img               String
  publishedAt       DateTime @default(now())
  Section           Section[]
}

model Section {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  // Arabic
  title       String
  content     String?
  // English
  titleEn     String?
  contentEn   String?
  list        Listsection[]
  article     Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId   String        @db.ObjectId
}

type Listsection {
  title     String?
  titleEn   String?
  content   String?
  contentEn String?
}
