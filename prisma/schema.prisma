// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  email    String  @unique
  password String
  name     String?
}

type ProjectLink {
  headerEn String
  headerAr String
  link     String
}

model Project {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  img           String
  title         String
  titleEn       String?
  descriptionEn String?
  description   String
  important     Boolean?
  types         String[]
  links         ProjectLink[]
}

model ProjectType {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  value   String @unique  // slug used in Project.types[] e.g. "lms", "ecommerce"
  labelEn String
  labelAr String
}

model Sponser {
  id  String @id @default(auto()) @map("_id") @db.ObjectId
  img String
}

model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  isReaded  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Article {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  // Arabic (primary)
  title             String
  content           String           // intro paragraph AR
  metaDesc          String?          // ≤160 chars for <meta description> AR
  // English
  titleEn           String?
  contentEn         String?          // intro paragraph EN
  metaDescEn        String?          // ≤160 chars for <meta description> EN
  // Media & meta
  img               String
  publishedAt       DateTime @default(now())
  Section           Section[]
}

model Section {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  // Arabic
  title       String
  content     String?
  // English
  titleEn     String?
  contentEn   String?
  list        Listsection[]
  article     Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId   String        @db.ObjectId
}

type Listsection {
  title     String?
  titleEn   String?
  content   String?
  contentEn String?
}
