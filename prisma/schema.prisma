// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String    @unique
  password  String
  name      String?
  role      String?   @default("client") // "admin" | "client" (null on legacy rows = treat as admin)
  createdAt DateTime? @default(now())
  // NOTE: no `academies` relation — the Academy control plane lives in MySQL
  // (prisma/mysql/schema.prisma). Link a user to academies by User.id string, not a relation.
}

type ProjectLink {
  headerEn String
  headerAr String
  link     String
}

model Project {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  img           String
  title         String
  titleEn       String?
  descriptionEn String?
  description   String
  important     Boolean?
  types         String[]
  links         ProjectLink[]
  order         Int           @default(0)
  // AI agent (search_projects): null/absent = visible; false hides it from the agent.
  aiVisible     Boolean?
  aiSummary     String?

  @@index([aiVisible])
}

model ProjectType {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  value   String @unique // slug used in Project.types[] e.g. "lms", "ecommerce"
  labelEn String
  labelAr String
}

model Sponser {
  id  String @id @default(auto()) @map("_id") @db.ObjectId
  img String
}

// NOTE: the Academy control plane now lives in MySQL, not here — see
// prisma/mysql/schema.prisma (client `@/lib/prismaMysql`). No Academy model in Mongo.
// (The client who owns an academy is a User here; Academy.ownerId in MySQL stores
// that User.id as a plain string — no cross-database relation.)

model Contact {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  // Core fields
  name                 String
  email                String
  phone                String?
  subject              String
  message              String
  // Qualifying fields
  country              String? // "sa" | "ae" | "qa" | "kw" | "bh" | "om" | "jo" | "eg" | "other"
  service              String? // "moodle" | "ecommerce" | "custom" | "other"
  budget               String? // "under5k" | "5to20k" | "20to50k" | "above50k" | "unknown"
  timeline             String? // "immediate" | "1to3months" | "3to6months" | "exploring"
  role                 String? // "owner" | "manager" | "employee" | "other"
  pain                 String?
  // Traffic tracking
  sourcePage           String? // page where form was submitted (/contact | /moodle-lms | /)
  sourceRef            String? // document.referrer (e.g. google.com)
  utmSource            String? // ?utm_source=
  utmMedium            String? // ?utm_medium=
  utmCampaign          String? // ?utm_campaign=
  // Auto-scored
  score                Int       @default(0)
  stage                String    @default("lead") // "lead" | "mql" | "sql" | "opportunity"
  // Admin
  status               String    @default("new") // "new" | "contacted" | "won" | "lost"
  notes                String?
  isReaded             Boolean   @default(false)
  createdAt            DateTime  @default(now())
  // ── AI agent (all optional so existing rows still read) ──
  company              String?
  orgType              String? // individual | company | government | education
  whatsapp             String?
  requirements         Json? // LeadRequirements (lib/agent/qualification/schemas.ts)
  tier                 String? // HOT | WARM | COLD (lead score v2)
  scoreBreakdown       Json? // [{ factor, points }]
  scoreVersion         Int? // algorithm version (v2 = 2)
  scoringConfigVersion Int? // settings version the score was computed with
  scoredAt             DateTime?
  aiSummary            String? // AI-generated sales brief (labelled as AI in the UI)
  nextAction           String? // CALL_TODAY | CALL_WITHIN_24H | SEND_PROPOSAL | REQUEST_MORE_INFO | HANDOFF_TO_TECHNICAL | WAIT_FOR_CLIENT
  consentContact       Boolean?
  consentAt            DateTime?
  conversationId       String?   @db.ObjectId // conversation that captured the lead
  nextFollowUpAt       DateTime? // sales sets it; the daily job drafts a follow-up that day (FR-F1)

  @@index([tier, createdAt])
  @@index([nextFollowUpAt])
  @@index([whatsapp])
  @@index([email])
}

model ServicePlan {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  service    String // "moodle" | "ecommerce" | "mobile"
  nameAr     String
  nameEn     String
  price      Int // starting price in USD
  currency   String   @default("USD")
  featuresAr String[] // Arabic feature list
  featuresEn String[] // English feature list
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model Article {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  // SEO-friendly URL slug (auto-generated from Arabic title)
  slug        String?   @unique
  // Arabic (primary)
  title       String
  content     String // intro paragraph AR
  metaDesc    String? // ≤160 chars for <meta description> AR
  // English
  titleEn     String?
  contentEn   String? // intro paragraph EN
  metaDescEn  String? // ≤160 chars for <meta description> EN
  // Media & meta
  img         String
  publishedAt DateTime  @default(now())
  Section     Section[]
  // AI agent (search_knowledge): null/absent = visible; false hides it from the agent.
  aiVisible   Boolean?
  aiSummary   String?

  @@index([aiVisible])
}

model Section {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  // Arabic
  title     String
  content   String?
  // English
  titleEn   String?
  contentEn String?
  list      Listsection[]
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String        @db.ObjectId
}

type Listsection {
  title     String?
  titleEn   String?
  content   String?
  contentEn String?
}

// ─────────────────────────────────────────────────────────────────────────────
// AI agent (lib/agent/**, SRS §5 and §13.3). Chat, audit and counters live here
// next to Contact; the agent settings live in the MySQL PlatformSetting key
// `ai_agent_config`. TTL indexes (AgentSession, ToolAudit, IdempotencyRecord,
// RateLimitBucket) can't be expressed in Prisma — create them once with
// `node scripts/agent-indexes.mjs` after `npm run mongo:push`.
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  channel          String        @default("web") // web | whatsapp
  mode             String        @default("sales") // sales | support — informational only, never grants access
  status           String        @default("open") // open | waiting_human | human | closed
  locale           String        @default("ar") // ar | en
  userId           String? // MySQL User.id when a client is signed in
  contactId        String?       @db.ObjectId
  sessionId        String?       @db.ObjectId // anonymous AgentSession (web)
  phoneE164        String? // WhatsApp number (phase 3)
  assignedTo       String? // staff User.id who took over
  sourcePage       String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  ipHash           String?
  summary          String?
  rating           Int? // 1 | -1
  ratingComment    String?
  tokensIn         Int           @default(0)
  tokensOut        Int           @default(0)
  messageCount     Int           @default(0)
  stateVersion     Int           @default(0) // bumped on every status transition
  qualification    Json? // QualificationSession + the lead draft before a Contact exists
  verification     Json? // WhatsApp: pending account verification { email, at } (FR-WA5)
  knowledgeVersion Int?
  nextAction       String?
  tags             Json? // analytics tags by the fast model (FR-N1): service, country, intent, questions, unknownQuestions…
  taggedAt         DateTime?
  turnLockUntil    DateTime      @default(now()) // one running turn per conversation
  lastMessageAt    DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  messages         ChatMessage[]

  @@index([status, lastMessageAt])
  @@index([channel, status])
  @@index([userId, status])
  @@index([sessionId])
  @@index([contactId])
  @@index([createdAt])
  @@index([assignedTo, status])
  @@index([phoneE164, channel, status])
}

model ChatMessage {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId    String       @db.ObjectId
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role              String // visitor | assistant | staff | tool | system
  content           String // text shown to the person, or redacted JSON for tool rows
  toolName          String?
  status            String       @default("sent") // sent | draft | discarded | failed
  staffId           String?
  model             String?
  tokensIn          Int?
  tokensOut         Int?
  latencyMs         Int?
  turnId            String?
  toolUseId         String?
  idempotencyKey    String? // uniqueness is enforced by IdempotencyRecord, not here (Mongo unique + missing field = collisions)
  // Phase 4 follow-up (status draft → sent | discarded): { kind, channel, to, locale, contactId, … }
  followup          Json?
  // Queryable copies (Prisma/Mongo can't filter a Json field by "is set").
  followupKind      String? // due | checkout | abandoned
  followupContactId String?      @db.ObjectId
  createdAt         DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([idempotencyKey])
  @@index([status, createdAt])
  @@index([followupContactId])
  @@index([followupKind, status])
}

model AgentSession {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  ipHash     String?
  userId     String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([lastSeenAt]) // TTL 30 days
}

model ToolAudit {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String   @db.ObjectId
  turnId         String
  tool           String
  argsRedacted   Json?
  authContext    Json? // { mode, channel, signedIn }
  status         String // ok | error
  errorCode      String?
  latencyMs      Int
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([createdAt]) // TTL 180 days
}

model IdempotencyRecord {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  key        String   @unique
  tool       String
  resultJson Json
  createdAt  DateTime @default(now())

  @@index([createdAt]) // TTL 7 days
}

// One row per model call (cost per visitor, per model; reconciles with the
// Anthropic console, which reports UTC days). The createdAt index is the TTL
// index from scripts/agent-indexes.mjs (180 days), so Prisma declares none.
model AgentUsageEvent {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  date             String // Africa/Cairo day, same as UsageDaily
  kind             String // chat | brief | tags | followup
  model            String // as returned by the API
  conversationId   String?  @db.ObjectId
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int
  cacheWriteTokens Int
  costUsd          Float
  createdAt        DateTime @default(now())

  @@index([conversationId])
}

model UsageDaily {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  date              String   @unique // YYYY-MM-DD in Africa/Cairo
  reservedUsd       Float    @default(0) // outstanding reservations
  spentUsd          Float    @default(0) // settled cost
  // reservedUsd + spentUsd in one field, so a reservation is ONE atomic
  // conditional update (`committedUsd <= budget - estimate`) — no $expr needed.
  committedUsd      Float    @default(0)
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  cacheReadTokens   Int      @default(0)
  cacheWriteTokens  Int      @default(0)
  priceTableVersion String?
  budgetAlerted     Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model RateLimitBucket {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@unique([key, windowStart])
  @@index([expiresAt]) // TTL (expireAfterSeconds: 0)
}

model CustomPriceRange {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  category  String   @unique // custom_lms | lms_mobile_apps | ecommerce_app | custom_software | …
  labelAr   String
  labelEn   String
  minUsd    Int
  maxUsd    Int? // null = "from"
  // Optional EGP range entered by sales for Egyptian clients — never converted from USD.
  minEgp    Int?
  maxEgp    Int? // null with minEgp set = "from"
  notesAr   String?
  notesEn   String?
  active    Boolean  @default(true)
  version   Int      @default(1) // optimistic concurrency → 409 config_version_conflict
  updatedBy String
  updatedAt DateTime @updatedAt
}

model MeetingRequest {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  contactId      String?  @db.ObjectId
  conversationId String   @db.ObjectId
  preferredAt    DateTime // requested Africa/Cairo wall time, stored as the UTC instant
  channel        String // call | online | visit
  status         String   @default("requested") // requested | confirmed | done | cancelled
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, preferredAt])
}

model Ticket {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String   @db.ObjectId
  userId         String
  tenantSlug     String?
  category       String // billing | provisioning | technical | other
  summary        String
  status         String   @default("open") // open | in_progress | resolved
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

// CRM timeline on a lead (FR-I4, §13.12): conversation-level events only.
model Activity {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  contactId      String   @db.ObjectId
  type           String   @default("chat")
  event          String // AI_CONVERSATION_STARTED | AI_LEAD_QUALIFIED | AI_HANDOFF | HUMAN_TAKEOVER | AI_FOLLOWUP_APPROVED
  channel        String   @default("web") // web | whatsapp
  conversationId String   @db.ObjectId
  score          Int?
  tier           String?
  summary        String?
  createdBy      String // "AI" or the staff User.id
  createdAt      DateTime @default(now())

  @@index([contactId, createdAt])
  @@index([conversationId])
}

model WhatsAppIdentity {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  phoneE164  String   @unique
  userId     String
  verifiedAt DateTime
  expiresAt  DateTime

  @@index([expiresAt])
}
